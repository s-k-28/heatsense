rules_version = '2';

// Every write goes through the Cloud Functions in /functions, which run with
// admin access and enforce the rules themselves (who is a coach, code expiry,
// rate limits, approval). Clients may only read what belongs to them. Invite
// records, the code index, coach pointers and rate limits are server-only, so
// codes can't be listed, looked up or enumerated from the app.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach(teamId) {
      return signedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.coachUid == request.auth.uid;
    }
    function isActiveMember(teamId) {
      let path = /databases/$(database)/documents/teamMembers/$(teamId + '_' + request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'active';
    }

    // Coaches and approved members can read their team; a pending athlete cannot.
    match /teams/{teamId} {
      allow read: if isCoach(teamId) || isActiveMember(teamId);
      allow write: if false;
    }

    // An athlete can watch their own membership; the team's coach can see all of the
    // team's (pending requests included). Nobody can approve or edit from the app.
    match /teamMembers/{membershipId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isCoach(resource.data.teamId));
      allow write: if false;
    }

    // Athlete profile (onboarding page 1). The athlete writes their own; every field is
    // checked here. Their coach can read it only once the athlete is an approved member.
    // Health answers and emergency contacts will live in separate documents.
    function isApprovedAthleteOf(teamId, uid) {
      let path = /databases/$(database)/documents/teamMembers/$(teamId + '_' + uid);
      return exists(path) && get(path).data.status == 'active';
    }
    function validAthleteProfile(data) {
      return data.keys().hasOnly(['fullName', 'ageBand', 'grade', 'sport', 'sportSource', 'jersey', 'teamId', 'onboarding', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['fullName', 'ageBand', 'grade', 'sport', 'sportSource', 'onboarding', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 60
        && data.ageBand in ['under13', '13to17', '18plus']
        && data.grade in ['6th', '7th', '8th', '9th', '10th', '11th', '12th', 'College', 'Other']
        && data.sport in ['Football', 'Soccer', 'Cross Country', 'Track & Field', 'Baseball', 'Softball', 'Tennis', 'Basketball', 'Volleyball', 'Other']
        && data.sportSource in ['team', 'self']
        && (!('jersey' in data) || data.jersey == null || (data.jersey is string && data.jersey.matches('[0-9]{1,3}')))
        && (!('teamId' in data) || data.teamId == null || (data.teamId is string && data.teamId.size() <= 128))
        && data.onboarding is map
        && data.onboarding.keys().hasOnly(['step', 'profileCompletedAt', 'bodyCompletedAt', 'safetySkipped', 'completedAt'])
        && data.onboarding.step in ['body', 'safety', 'done']
        && data.onboarding.profileCompletedAt is timestamp
        && (!('bodyCompletedAt' in data.onboarding) || data.onboarding.bodyCompletedAt is timestamp)
        && (!('safetySkipped' in data.onboarding) || data.onboarding.safetySkipped is bool)
        && (!('completedAt' in data.onboarding) || data.onboarding.completedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /athletes/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || (resource.data.teamId is string && isCoach(resource.data.teamId) && isApprovedAthleteOf(resource.data.teamId, uid)));
      allow create: if signedIn() && request.auth.uid == uid
        && validAthleteProfile(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && validAthleteProfile(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Health answers (onboarding page 2) and emergency information (page 3). Only the
      // athlete: no coach, teammate or team query can read them. Staff access, if added,
      // must be defined and enforced here (or server-side), never by hiding fields in the app.
      match /private/{docId} {
        allow read, delete: if signedIn() && request.auth.uid == uid && docId in ['health', 'safety'];
        allow create, update: if signedIn() && request.auth.uid == uid
          && ((docId == 'health' && validHealth(request.resource.data))
            || (docId == 'safety' && validSafety(request.resource.data)));
      }
    }

    function validHealth(data) {
      let concerns = data.heatConcerns;
      return data.keys().hasOnly(['heightCm', 'weightKg', 'previousHeatIllness', 'previousHeatIllnessType', 'heatConcerns', 'otherConcern', 'heatAcclimatization', 'updatedAt'])
        && data.keys().hasAll(['heightCm', 'weightKg', 'previousHeatIllness', 'previousHeatIllnessType', 'heatConcerns', 'otherConcern', 'heatAcclimatization', 'updatedAt'])
        && (data.heightCm == null || (data.heightCm is number && data.heightCm >= 90 && data.heightCm <= 245))
        && (data.weightKg == null || (data.weightKg is number && data.weightKg >= 18 && data.weightKg <= 275))
        && (data.previousHeatIllness == null || data.previousHeatIllness in ['yes', 'no', 'notSure', 'preferNot'])
        && (data.previousHeatIllnessType == null
          || (data.previousHeatIllness == 'yes' && data.previousHeatIllnessType in ['heatExhaustion', 'heatstroke', 'otherUnsure', 'preferNot']))
        && concerns is list && concerns.size() <= 6
        && concerns.hasOnly(['heatIntolerance', 'dizzinessFainting', 'symptomsDuringExercise', 'medicalCondition', 'medicationConcern', 'other', 'none', 'preferNot'])
        && (!('none' in concerns) || concerns.size() == 1)
        && (!('preferNot' in concerns) || concerns.size() == 1)
        && (data.otherConcern == null || ('other' in concerns && data.otherConcern is string && data.otherConcern.size() >= 1 && data.otherConcern.size() <= 120))
        && (data.heatAcclimatization == null || data.heatAcclimatization in ['very', 'somewhat', 'not', 'notSure', 'preferNot'])
        && data.updatedAt == request.time;
    }

    function validContact(contact) {
      return contact is map
        && contact.keys().hasOnly(['name', 'relationship', 'phoneNumber'])
        && contact.keys().hasAll(['name', 'relationship', 'phoneNumber'])
        && contact.name is string && contact.name.size() >= 2 && contact.name.size() <= 80
        && contact.relationship in ['parent', 'guardian', 'family', 'other']
        && contact.phoneNumber is string && contact.phoneNumber.matches('[+][1-9][0-9]{6,14}');
    }

    function validSafety(data) {
      return data.keys().hasOnly(['primaryContact', 'secondaryContact', 'safetyNotes', 'updatedAt'])
        && data.keys().hasAll(['primaryContact', 'secondaryContact', 'safetyNotes', 'updatedAt'])
        && (data.primaryContact == null || validContact(data.primaryContact))
        // No second contact without a first.
        && (data.secondaryContact == null || (data.primaryContact != null && validContact(data.secondaryContact)))
        && (data.safetyNotes == null || (data.safetyNotes is string && data.safetyNotes.size() >= 1 && data.safetyNotes.size() <= 500))
        && data.updatedAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
