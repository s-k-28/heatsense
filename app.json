{
  "expo": {
    "name": "HeatSense",
    "slug": "heatsense-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/heatsense-app-icon.png",
    "scheme": "heatsenseapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/heatsense-app-icon.png",
      "bundleIdentifier": "com.s-k-28.heatsense-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/heatsense-app-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/heatsense-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.160498199797-d7k3fafcpi86cs4eei8it7q1ihlo4g34"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101416",
          "image": "./assets/images/heatsense-logo.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-widgets",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "HeatSense uses your location to show the city and field where your team practices."
        }
      ],
      "expo-maps"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
