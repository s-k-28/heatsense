rules_version = '2';

// HeatSense runs on the free Firebase plan, with no server code: the app writes to Firestore
// directly and these rules are the only gatekeeper. They decide who is a coach, which invite
// codes are live, that joining only ever creates a PENDING request, and that only a team's coach
// approves it. Every rule is exercised by scripts/test-team-invites.mjs (npm run test:invites).
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isCoach(teamId) {
      return signedIn() && get(/databases/$(database)/documents/teams/$(teamId)).data.coachUid == request.auth.uid;
    }
    function isActiveMember(teamId) {
      let path = /databases/$(database)/documents/teamMembers/$(teamId + '_' + request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'active';
    }

    // Teams. A coach creates their own and edits only its details and active code; approved
    // members can read it; a pending athlete cannot. (Free plan: no server, so the rules check it all.)
    function validTeam(d) {
      return d.keys().hasOnly(['name', 'school', 'sport', 'level', 'coachUid', 'createdBy', 'status', 'activeCode', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 80
        && d.school is string && d.school.size() >= 1 && d.school.size() <= 80
        && d.sport is string && d.sport.size() >= 1 && d.sport.size() <= 40
        && d.level is string && d.level.size() >= 1 && d.level.size() <= 40
        && (d.activeCode == null || (d.activeCode is string && d.activeCode.matches('^[0-9]{6}$')));
    }
    match /teams/{teamId} {
      allow read: if signedIn() && (resource.data.coachUid == request.auth.uid || isActiveMember(teamId));
      allow create: if signedIn() && validTeam(request.resource.data)
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.activeCode == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && resource.data.coachUid == request.auth.uid
        && validTeam(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'school', 'sport', 'level', 'activeCode', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.activeCode == null
          || get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.activeCode)).data.teamId == teamId);
      allow delete: if false;
    }

    // Invite codes. Anyone signed in can look up one exact code (never list them). Only the team's
    // coach creates a code (only if it isn't taken) or revokes one. Codes last at most 8 days.
    function liveCode(code, teamId) {
      let path = /databases/$(database)/documents/inviteCodes/$(code);
      return exists(path) && get(path).data.teamId == teamId && get(path).data.revoked == false && get(path).data.expiresAt > request.time;
    }
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[0-9]{6}$')
        && isCoach(request.resource.data.teamId)
        && request.resource.data.keys().hasOnly(['teamId', 'team', 'createdBy', 'createdAt', 'expiresAt', 'revoked'])
        && request.resource.data.team == {
          'teamName': get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name,
          'school': get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.school,
          'sport': get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.sport }
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.revoked == false;
      allow update: if isCoach(resource.data.teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revoked'])
        && request.resource.data.revoked == true;
      allow delete: if false;
    }

    function isActiveTrainer(teamId) {
      let path = /databases/$(database)/documents/teamMembers/$(teamId + '_' + request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == 'active' && get(path).data.role == 'trainer';
    }

    // Everyone can watch their own membership; the team's coach sees all of the team's (pending
    // requests included); an approved trainer sees the roster; an approved athlete sees who the
    // team's athletic trainers are, but not other athletes. Nobody can approve or edit from the app.
    match /teamMembers/{membershipId} {
      allow read: if signedIn() && (
        // Your own membership, even before it exists (so the app can check before asking to join).
        membershipId.matches('.+_' + request.auth.uid + '$')
        || resource.data.userId == request.auth.uid
        || isCoach(resource.data.teamId)
        || isActiveTrainer(resource.data.teamId)
        || (resource.data.role == 'trainer' && resource.data.status == 'active' && isActiveMember(resource.data.teamId)));
      // Asking to join: your own PENDING request, with a live code for that team, never your own team.
      allow create: if signedIn()
        && membershipId == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['teamId', 'userId', 'role', 'status', 'inviteCode', 'team', 'displayName', 'email', 'requestedAt', 'joinedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role in ['athlete', 'trainer']
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time
        && request.resource.data.joinedAt == null
        && liveCode(request.resource.data.inviteCode, request.resource.data.teamId)
        && request.resource.data.team == get(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.team
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.coachUid != request.auth.uid
        && request.resource.data.displayName == request.auth.token.get('name', null)
        && request.resource.data.email == request.auth.token.get('email', null);
      allow update: if signedIn() && (
        // The coach approves or declines a pending request; nothing else changes.
        (isCoach(resource.data.teamId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['active', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'joinedAt', 'respondedAt', 'respondedBy'])
          && request.resource.data.respondedAt == request.time
          && request.resource.data.respondedBy == request.auth.uid
          && request.resource.data.joinedAt == (request.resource.data.status == 'active' ? request.time : null))
        // Declined before: ask again with a live code for the same team.
        || (resource.data.userId == request.auth.uid
          && resource.data.status == 'declined'
          && request.resource.data.status == 'pending'
          && request.resource.data.role in ['athlete', 'trainer']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status', 'inviteCode', 'team', 'requestedAt'])
          && request.resource.data.requestedAt == request.time
          && liveCode(request.resource.data.inviteCode, resource.data.teamId)));
      allow delete: if false;
    }

    // Athlete profile (onboarding page 1). The athlete writes their own; every field is
    // checked here. Their coach can read it only once the athlete is an approved member.
    // Health answers and emergency contacts will live in separate documents.
    function isApprovedAthleteOf(teamId, uid) {
      let path = /databases/$(database)/documents/teamMembers/$(teamId + '_' + uid);
      return exists(path) && get(path).data.status == 'active';
    }
    function validAthleteProfile(data) {
      return data.keys().hasOnly(['fullName', 'ageBand', 'grade', 'sport', 'sportSource', 'jersey', 'teamId', 'onboarding', 'createdAt', 'updatedAt'])
        && data.keys().hasAll(['fullName', 'ageBand', 'grade', 'sport', 'sportSource', 'onboarding', 'createdAt', 'updatedAt'])
        && data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 60
        && data.ageBand in ['under13', '13to17', '18plus']
        && data.grade in ['6th', '7th', '8th', '9th', '10th', '11th', '12th', 'College', 'Other']
        && data.sport in ['Football', 'Soccer', 'Cross Country', 'Track & Field', 'Baseball', 'Softball', 'Tennis', 'Basketball', 'Volleyball', 'Other']
        && data.sportSource in ['team', 'self']
        && (!('jersey' in data) || data.jersey == null || (data.jersey is string && data.jersey.matches('[0-9]{1,3}')))
        && (!('teamId' in data) || data.teamId == null || (data.teamId is string && data.teamId.size() <= 128))
        && data.onboarding is map
        && data.onboarding.keys().hasOnly(['step', 'profileCompletedAt', 'bodyCompletedAt', 'safetySkipped', 'completedAt'])
        && data.onboarding.step in ['body', 'safety', 'done']
        && data.onboarding.profileCompletedAt is timestamp
        && (!('bodyCompletedAt' in data.onboarding) || data.onboarding.bodyCompletedAt is timestamp)
        && (!('safetySkipped' in data.onboarding) || data.onboarding.safetySkipped is bool)
        && (!('completedAt' in data.onboarding) || data.onboarding.completedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    match /athletes/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid
        || (resource.data.teamId is string && isCoach(resource.data.teamId) && isApprovedAthleteOf(resource.data.teamId, uid)));
      allow create: if signedIn() && request.auth.uid == uid
        && validAthleteProfile(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && validAthleteProfile(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      // Health answers (onboarding page 2) and emergency information (page 3). Only the
      // athlete: no coach, teammate or team query can read them. Staff access, if added,
      // must be defined and enforced here (or server-side), never by hiding fields in the app.
      match /private/{docId} {
        allow read, delete: if signedIn() && request.auth.uid == uid && docId in ['health', 'safety'];
        allow create, update: if signedIn() && request.auth.uid == uid
          && ((docId == 'health' && validHealth(request.resource.data))
            || (docId == 'safety' && validSafety(request.resource.data)));
      }
    }

    function validHealth(data) {
      let concerns = data.heatConcerns;
      return data.keys().hasOnly(['heightCm', 'weightKg', 'previousHeatIllness', 'previousHeatIllnessType', 'heatConcerns', 'otherConcern', 'heatAcclimatization', 'updatedAt'])
        && data.keys().hasAll(['heightCm', 'weightKg', 'previousHeatIllness', 'previousHeatIllnessType', 'heatConcerns', 'otherConcern', 'heatAcclimatization', 'updatedAt'])
        && (data.heightCm == null || (data.heightCm is number && data.heightCm >= 90 && data.heightCm <= 245))
        && (data.weightKg == null || (data.weightKg is number && data.weightKg >= 18 && data.weightKg <= 275))
        && (data.previousHeatIllness == null || data.previousHeatIllness in ['yes', 'no', 'notSure', 'preferNot'])
        && (data.previousHeatIllnessType == null
          || (data.previousHeatIllness == 'yes' && data.previousHeatIllnessType in ['heatExhaustion', 'heatstroke', 'otherUnsure', 'preferNot']))
        && concerns is list && concerns.size() <= 6
        && concerns.hasOnly(['heatIntolerance', 'dizzinessFainting', 'symptomsDuringExercise', 'medicalCondition', 'medicationConcern', 'other', 'none', 'preferNot'])
        && (!('none' in concerns) || concerns.size() == 1)
        && (!('preferNot' in concerns) || concerns.size() == 1)
        && (data.otherConcern == null || ('other' in concerns && data.otherConcern is string && data.otherConcern.size() >= 1 && data.otherConcern.size() <= 120))
        && (data.heatAcclimatization == null || data.heatAcclimatization in ['very', 'somewhat', 'not', 'notSure', 'preferNot'])
        && data.updatedAt == request.time;
    }

    function validContact(contact) {
      return contact is map
        && contact.keys().hasOnly(['name', 'relationship', 'phoneNumber'])
        && contact.keys().hasAll(['name', 'relationship', 'phoneNumber'])
        && contact.name is string && contact.name.size() >= 2 && contact.name.size() <= 80
        && contact.relationship in ['parent', 'guardian', 'family', 'other']
        && contact.phoneNumber is string && contact.phoneNumber.matches('[+][1-9][0-9]{6,14}');
    }

    function validSafety(data) {
      return data.keys().hasOnly(['primaryContact', 'secondaryContact', 'safetyNotes', 'updatedAt'])
        && data.keys().hasAll(['primaryContact', 'secondaryContact', 'safetyNotes', 'updatedAt'])
        && (data.primaryContact == null || validContact(data.primaryContact))
        // No second contact without a first.
        && (data.secondaryContact == null || (data.primaryContact != null && validContact(data.secondaryContact)))
        && (data.safetyNotes == null || (data.safetyNotes is string && data.safetyNotes.size() >= 1 && data.safetyNotes.size() <= 500))
        && data.updatedAt == request.time;
    }

    // Practice sessions and WBGT readings. The coach records; approved members can follow along.
    // Readings are append-only: the only later change is the coach's one-time acknowledgment.
    function uilZone(f, uilClass) {
      let b = uilClass == 3
        ? { 'yellow': 82.0, 'orange': 87.0, 'red': 90.1, 'black': 92.1 }
        : { 'yellow': 79.7, 'orange': 84.7, 'red': 87.7, 'black': 89.8 };
      return f >= b.black ? 'black' : f >= b.red ? 'red' : f >= b.orange ? 'orange' : f >= b.yellow ? 'yellow' : 'green';
    }

    match /teams/{teamId}/sessions/{sessionId} {
      allow read: if isCoach(teamId) || isActiveMember(teamId);
      allow create: if isCoach(teamId)
        && request.resource.data.keys().hasOnly(['venue', 'uilClass', 'recheckMinutes', 'policy', 'startedBy', 'startedAt', 'endedAt'])
        && request.resource.data.venue is string && request.resource.data.venue.size() >= 1 && request.resource.data.venue.size() <= 80
        && request.resource.data.uilClass in [2, 3]
        && request.resource.data.recheckMinutes is int && request.resource.data.recheckMinutes >= 5 && request.resource.data.recheckMinutes <= 120
        && request.resource.data.policy is string
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null;
      allow update: if isCoach(teamId)
        && resource.data.endedAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt'])
        && request.resource.data.endedAt == request.time;
      allow delete: if false;

      match /readings/{readingId} {
        function session() { return get(/databases/$(database)/documents/teams/$(teamId)/sessions/$(sessionId)).data; }
        allow read: if isCoach(teamId) || isActiveMember(teamId);
        allow create: if isCoach(teamId)
          && session().endedAt == null
          && request.resource.data.keys().hasOnly(['wbgtF', 'enteredValue', 'enteredUnit', 'source', 'measuredAt', 'zone', 'uilClass', 'recordedBy', 'recordedAt', 'acknowledgedBy', 'acknowledgedAt'])
          && request.resource.data.wbgtF is number && request.resource.data.wbgtF >= 32 && request.resource.data.wbgtF <= 120
          && request.resource.data.enteredValue is number
          && request.resource.data.enteredUnit in ['F', 'C']
          && request.resource.data.source in ['handheld', 'station', 'other']
          && request.resource.data.measuredAt is timestamp
          && request.resource.data.measuredAt <= request.time + duration.value(1, 'm')
          && request.resource.data.uilClass == session().uilClass
          // The server, not the app, decides the zone a reading falls in.
          && request.resource.data.zone == uilZone(request.resource.data.wbgtF, session().uilClass)
          && request.resource.data.recordedBy == request.auth.uid
          && request.resource.data.recordedAt == request.time
          && request.resource.data.acknowledgedBy == null
          && request.resource.data.acknowledgedAt == null;
        allow update: if isCoach(teamId)
          && resource.data.acknowledgedAt == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy', 'acknowledgedAt'])
          && request.resource.data.acknowledgedBy == request.auth.uid
          && request.resource.data.acknowledgedAt == request.time;
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
